<?xml version="1.0" ?>
<sdf version="1.6">
<world name="circle_swap_arena">
  <plugin name='gazebo_ros_state' filename='libgazebo_ros_state.so'>
    <ros>
      <argument>model_states:=model_states_demo</argument>
    </ros>
    <update_rate>1.0</update_rate>
  </plugin>

  <include>
    <uri>model://sun</uri>
  </include>
  <include>
    <uri>model://ground_plane</uri>
  </include>

  <!-- Boundary walls: 8m x 8m square arena (robots operate within R=2.5m circle) -->
  <model name="b_north">
    <static>true</static>
    <pose>0.0 4.0 0.75 0 0 0</pose>
    <link name="link">
      <collision name="collision"><geometry><box><size>8.0 0.2 1.5</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>8.0 0.2 1.5</size></box></geometry></visual>
    </link>
  </model>

  <model name="b_south">
    <static>true</static>
    <pose>0.0 -4.0 0.75 0 0 0</pose>
    <link name="link">
      <collision name="collision"><geometry><box><size>8.0 0.2 1.5</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>8.0 0.2 1.5</size></box></geometry></visual>
    </link>
  </model>

  <model name="b_east">
    <static>true</static>
    <pose>4.0 0.0 0.75 0 0 0</pose>
    <link name="link">
      <collision name="collision"><geometry><box><size>0.2 8.0 1.5</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.2 8.0 1.5</size></box></geometry></visual>
    </link>
  </model>

  <model name="b_west">
    <static>true</static>
    <pose>-4.0 0.0 0.75 0 0 0</pose>
    <link name="link">
      <collision name="collision"><geometry><box><size>0.2 8.0 1.5</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.2 8.0 1.5</size></box></geometry></visual>
    </link>
  </model>

  <!-- Dynamic obstacles (parked far away, can be moved by obstacle_mover if enabled) -->
  <model name="dyn_obs_0">
    <static>true</static>
    <pose>3.5 3.5 0.4 0 0 0</pose>
    <link name="link">
      <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.8</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>0.8</length></cylinder></geometry></visual>
    </link>
  </model>
  <model name="dyn_obs_1">
    <static>true</static>
    <pose>-3.5 3.5 0.4 0 0 0</pose>
    <link name="link">
      <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.8</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>0.8</length></cylinder></geometry></visual>
    </link>
  </model>
  <model name="dyn_obs_2">
    <static>true</static>
    <pose>3.5 -3.5 0.4 0 0 0</pose>
    <link name="link">
      <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.8</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>0.8</length></cylinder></geometry></visual>
    </link>
  </model>
  <model name="dyn_obs_3">
    <static>true</static>
    <pose>-3.5 -3.5 0.4 0 0 0</pose>
    <link name="link">
      <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.8</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>0.8</length></cylinder></geometry></visual>
    </link>
  </model>
  <model name="dyn_obs_4">
    <static>true</static>
    <pose>3.5 0.0 0.4 0 0 0</pose>
    <link name="link">
      <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.8</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>0.8</length></cylinder></geometry></visual>
    </link>
  </model>
  <model name="dyn_obs_5">
    <static>true</static>
    <pose>-3.5 0.0 0.4 0 0 0</pose>
    <link name="link">
      <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.8</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>0.8</length></cylinder></geometry></visual>
    </link>
  </model>
  <model name="dyn_obs_6">
    <static>true</static>
    <pose>0.0 3.5 0.4 0 0 0</pose>
    <link name="link">
      <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.8</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>0.8</length></cylinder></geometry></visual>
    </link>
  </model>
  <model name="dyn_obs_7">
    <static>true</static>
    <pose>0.0 -3.5 0.4 0 0 0</pose>
    <link name="link">
      <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.8</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>0.8</length></cylinder></geometry></visual>
    </link>
  </model>
</world>
</sdf>
